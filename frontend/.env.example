# Base URL of the Airecruitx backend.
# Port 5001, not 5000 — macOS Control Center (AirPlay Receiver) occupies 5000,
# so the backend's PORT in Airecruitx-backend/.env is set to 5001 to match.
NEXT_PUBLIC_API_URL=http://localhost:5001

# Firebase web config — only used to obtain a Google ID token, which the
# backend exchanges via POST /api/auth/google. These are public client values
# (they ship in the JS bundle); the privileged service-account credentials stay
# in the backend's own .env. Leave them unset to hide the Google button.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBPq5muJxirM2e7rxjGwRFWGSJICxIaUDc
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=airecruitx-a8140.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=airecruitx-a8140