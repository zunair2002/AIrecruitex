# Base URL of the Airecruitx backend (Airecruitx-backend).
# Note: on macOS, Control Center's AirPlay Receiver occupies port 5000, so this
# project runs the backend on 5001 (see PORT in Airecruitx-backend/.env).
NEXT_PUBLIC_API_URL=http://localhost:5001

# Firebase web config for Google sign-in (Firebase console -> Project settings
# -> Your apps -> Web app). Public client values. Omit them and the Google
# button is hidden; email/password sign-in is unaffected.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
